            "values": [
              "image: twentycrm/twenty:latest\n\n# A list of env that can be set:\n# https://twenty.com/developers/section/self-hosting/self-hosting-var\nenv:\n  STORAGE_TYPE: \"local\"\n  SIGN_IN_PREFILLED: \"false\"\n  ACCESS_TOKEN_EXPIRES_IN: 7d\n  LOGIN_TOKEN_EXPIRES_IN: 1h\n\nsecrets:\n  appToken: \"TueRippCNQYc190gdeAABwwxVdMfpl07uwNFjFQ0CtE=\"\n  accessToken: \"U9U0IbuNBiaUM4M7PTKqmXX3R1a/xHWGEsC7wSbJnA8=\"\n  loginToken: \"wjVNy5+MZJ4WeRSe+GjF0TcJsD0bYG158ttKjulWVPo=\"\n  refreshToken: \"HRppVAOuJtCVCd51EaJ8VIE+ybpRmDfuODjESE2x9jk=\"\n  fileToken: \"4r7zZyaY9/35pd8o3BMf6sWLlLr5dqOsFOLhk9yiY0g=\"\n\n\nserver:\n  replicas: 1\n  storage: 2Gi\n  #storageClassName:\n  resources:\n    requests:\n      memory: \"128Mi\"\n      cpu: \"100m\"\n\nworker:\n  replicas: 1\n  resources:\n    requests:\n      memory: \"128Mi\"\n      cpu: \"100m\"\n\ndb:\n  enabled: true\n  image: twentycrm/twenty-postgres:latest\n  storage: 2Gi\n  storageClassName: gp2\n\n  #adminPassword: some-random-string\n\n  # those should be set in stone because are configured in init.sql\n  database: twenty\n  user: twenty\n  password: twenty\n\n  resources:\n    requests:\n      memory: \"256Mi\"\n      cpu: \"100m\"\n\nexternalDb:\n  enabled: false\n  postgresConnectionString: \"postgres://twenty:twenty@host:5432/twenty\"\n\nredis:\n  image: redis:latest\n  resources:\n    requests:\n      memory: \"128Mi\"\n      cpu: \"20m\"\n\n\n\ningress:\n  enabled: false\n\n"
